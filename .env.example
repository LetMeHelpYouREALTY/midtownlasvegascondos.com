# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# Optional: for rate limiting
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_rest_token

# --- Google Search Console ---
# HTML tag method: copy content value from Search Console → Settings → Ownership verification
# Add to Vercel Production env vars, redeploy, then click Verify in Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-verification-code"

# Google Analytics (Search Console links to GA property)
NEXT_PUBLIC_GA_ID="G-772V5VK7G0"

# Optional: Google Tag Manager
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Optional: Cloudflare Images profile photo (imagedelivery.net)
# NEXT_PUBLIC_AGENT_PHOTO_URL="https://imagedelivery.net/<account>/<image-id>/public"

# Vercel Workflow SDK — Calendly → Follow Up Boss runs as durable workflow on Vercel
# Inspect runs locally: pnpm workflow:web

# --- After deploy (2026 Search Console checklist) ---
# 1. Verify property: https://search.google.com/search-console (URL prefix: www)
# 2. Submit sitemap — if "Couldn't fetch", try: sitemap.xml/ (trailing slash)
# 3. URL Inspection → Request indexing for /, /guides, /midtown-real-estate
# 4. Monitor: Performance, Page indexing, Core Web Vitals (mobile p75), Gen AI reports
# 5. Link GA4 property G-772V5VK7G0; check Acquisition → AI Assistant channel
# 6. FAQPage schema: rich results retired May 2026 — keep markup for AI parsing
