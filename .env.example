# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# Optional: for rate limiting
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_rest_token

# --- Google Search Console ---
# HTML tag method: copy content value from Search Console → Settings → Ownership verification
# Add to Vercel Production env vars, redeploy, then click Verify in Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-verification-code"

# Google Analytics (Search Console links to GA property)
NEXT_PUBLIC_GA_ID="G-772V5VK7G0"

# Optional: Google Tag Manager
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# --- After deploy ---
# 1. Verify property: https://search.google.com/search-console
# 2. Submit sitemap: https://www.midtownlasvegascondos.com/sitemap.xml
# 3. Request indexing for homepage and /guides
